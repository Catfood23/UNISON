# Server-only Apps Script bridge settings. Copy to .env and fill these in locally.
UNISON_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
UNISON_GOOGLE_SHARED_SECRET=replace-with-a-long-random-secret
# Optional for local admin testing; use a unique value of at least 24 characters.
UNISON_ADMIN_PASSWORD=
